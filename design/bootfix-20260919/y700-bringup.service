[Unit]
Description=Y700 staged hardware bring-up (reviewed one-shot bundles: display .. Wi-Fi .. Bluetooth .. audio)
Documentation=file:/home/siwal/y700-design/bootfix-20260919/README.md
After=network.target NetworkManager.service systemd-udev-settle.service
ConditionPathExists=!/home/siwal/y700-agent/bringup.disable
# stopping would kill the DRM owner / GPU keeper (they must live for the whole boot)
RefuseManualStop=yes

[Service]
Type=exec
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -B /home/siwal/y700-design/nextboot-impl/bringup.py --upto audio-c --wifi
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
