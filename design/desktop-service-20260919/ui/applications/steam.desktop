[Desktop Entry]
Type=Application
Name=x86 Steam (FEX)
Comment=Steam (x86-64 via FEX, SysV IPC compatibility, no user namespaces)
Exec=FEXBash -c /home/siwal/y700-steam/y700-steam.sh
Icon=/home/siwal/y700-steam/launcher/usr/share/icons/hicolor/256x256/apps/steam.png
Categories=Game;
X-Purism-FormFactor=Workstation;Mobile;
Terminal=false
# hidden from the app grid: its library is separate from the arm64 client's, so a game installed there shows up
# here as "not installed" and a tap re-downloads it into the wrong library. Still launchable from a terminal.
NoDisplay=true
StartupWMClass=steam
