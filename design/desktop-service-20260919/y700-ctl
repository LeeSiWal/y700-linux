#!/usr/bin/env python3
"""Talk to y700-desktop.service: y700-ctl brightness up|down|get|0..100 ; y700-ctl rotate next|get|0|90|180|270"""
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(3)
try: s.connect('/run/y700-desktop/ctl.sock')
except OSError as e: sys.exit('desktop control not available: %s' % e)
s.sendall(' '.join(sys.argv[1:]).encode()); r = s.recv(256).decode().strip(); print(r)
sys.exit(0 if not r.startswith('error') else 1)
