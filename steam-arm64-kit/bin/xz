#!/usr/bin/env python3
"""Minimal xz stand-in (this Ubuntu image has no xz-utils): supports the decompress-to-stdout / list usage of steam.sh and tar."""
import lzma, sys
args = [a for a in sys.argv[1:] if a not in ('-d', '--decompress', '-c', '--stdout', '-q', '-k', '--keep', '-T0')]
files = [a for a in args if not a.startswith('-')]
if '--robot' in sys.argv[1:] and ('-l' in sys.argv[1:] or '--list' in sys.argv[1:]):
    for f in files:                                        # steam.sh: xz --robot --list -> "totals" line, field 5 = uncompressed size
        with lzma.open(f) as fh:
            n = 0
            while True:
                b = fh.read(1 << 20)
                if not b: break
                n += len(b)
        import os
        print('totals\t1\t1\t%d\t%d\t1.0\tCRC64\t0\t0' % (os.path.getsize(f), n))
    sys.exit(0)
if '-l' in sys.argv[1:] or '--list' in sys.argv[1:]:
    for f in files:
        with lzma.open(f) as fh:
            n = 0
            while True:
                b = fh.read(1 << 20)
                if not b: break
                n += len(b)
        print('  1 %9d %11d  %s' % (0, n, f))
    sys.exit(0)
src = lzma.open(files[0], 'rb') if files else lzma.LZMAFile(sys.stdin.buffer)
out = sys.stdout.buffer
while True:
    b = src.read(1 << 20)
    if not b: break
    out.write(b)
out.flush()
